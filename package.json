{
  "name": "@weibaohui/dsh-flow",
  "version": "0.1.1",
  "description": "dsh 插件 · 执行流程图：把当前会话的执行过程画成一条纵向节点流（回合/用户/助手/工具/审批/重试/压缩），SSE 实时追加——会话执行到哪，图就画到哪，自动跟随滚动。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "flow",
    "trajectory",
    "visualization",
    "realtime",
    "sse",
    "dsh-plugin"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "docs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/index.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build:client && npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/dsh-flow.git"
  },
  "homepage": "https://github.com/weibaohui/dsh-flow#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/dsh-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
